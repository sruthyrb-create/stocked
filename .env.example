# Copy to .env and fill in. Never commit .env.

# --- Ring Partner API (leave blank to use the built-in simulator) ---
RING_ACCESS_TOKEN=
RING_REFRESH_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HARDWARE_ID=
RING_HMAC_KEY=stocked-local-demo-key   # webhook signing key from the Ring Developer Portal

# Your fridges: Ring device id per fridge (shelf_box optional, fractions x0,y0,x1,y1 of the frame)
# STOCKED_FRIDGES=[{"name":"Maple Street Fridge","address":"Outside the laundromat","device_id":"<ring device id>","shelf_box":[0.33,0.13,0.67,0.94]}]

# --- Amazon Bedrock (optional; without it a no-AI fill estimate is used) ---
STOCKED_BEDROCK=0
AWS_REGION=us-east-1
BEDROCK_VISION_MODEL_ID=us.amazon.nova-lite-v1:0

# --- Alerts (ntfy.sh topic URLs or any JSON webhook) ---
STOCKED_VOLUNTEER_NOTIFY_URL=
STOCKED_PUBLIC_NOTIFY_URL=
STOCKED_NETWORK_NAME=Neighborhood Fridge Network

# --- Tuning ---
STOCKED_DEBOUNCE_S=20          # wait this long after the last motion before looking at the shelves
STOCKED_EMPTY_ALERT_MIN=30     # alert volunteers when a fridge has been empty this long
STOCKED_STALE_HOURS=6          # mark a reading as old after this long
STOCKED_FULL_COVERAGE=0.45     # heuristic calibration: shelf coverage of a packed fridge
